# Copy this file to .env and fill in the values.
# The .env file is gitignored — never commit it.

# Absolute path to the weights/ directory on the GPU box.
# Default is "weights" (relative to where you run uvicorn from).
WEIGHTS_DIR=weights

# Absolute path to the cloned D-FINE repository.
# The loader appends this to sys.path to import src.core.YAMLConfig.
# Example: /opt/D-FINE
DFINE_REPO_PATH=/opt/D-FINE

# Minimum confidence score returned by /api/infer.
# Anything below this floor is dropped server-side.
# Threshold filtering above this floor happens client-side.
MIN_SCORE_FLOOR=0.05

# CORS allowed origins — "*" works for single-box Option A deployment.
# Separate multiple values with commas, e.g.: http://localhost:5173,http://your-ip
CORS_ORIGINS=["*"]
